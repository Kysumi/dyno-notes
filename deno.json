{
  "version": "1.4.0",
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite@8.1.3",
    "build": "deno run -A npm:vite@8.1.3 build",
    "test": "deno test -P=test",
    "check": "deno check main.ts src/main.tsx && deno lint && deno task test && deno task build",
    "desktop": "deno task build && deno desktop -P=desktop main.ts",
    "desktop:dev": "deno desktop -P=desktop --hmr main.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["DOM", "DOM.Iterable", "ESNext", "deno.ns"]
  },
  "lint": {
    "exclude": ["src/components/ui/"]
  },
  "permissions": {
    "desktop": {
      "read": true,
      "write": true,
      "env": ["HOME", "USERPROFILE"]
    },
    "test": {
      "read": true,
      "write": true,
      "env": ["HOME", "USERPROFILE"]
    }
  },
  "desktop": {
    "app": {
      "name": "Dyno Notes",
      "identifier": "com.dynonotes.app"
    },
    "output": {
      "macos": "./build/Dyno Notes.app",
      "windows": "./build/Dyno Notes",
      "linux": "./build/dyno-notes.AppImage"
    }
  },
  "imports": {
    "@/": "./src/",
    "@/components/ui/button": "./src/components/ui/button.tsx",
    "@/components/ui/input": "./src/components/ui/input.tsx",
    "@/components/ui/input-group": "./src/components/ui/input-group.tsx",
    "@/components/ui/textarea": "./src/components/ui/textarea.tsx",
    "@/lib/utils": "./src/lib/utils.ts",
    "@radix-ui/react-slot": "npm:@radix-ui/react-slot@^1.3.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@types/react": "npm:@types/react@^19.2.17",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.0.3",
    "class-variance-authority": "npm:class-variance-authority@^0.7.1",
    "clsx": "npm:clsx@^2.1.1",
    "lucide-react": "npm:lucide-react@^1.25.0",
    "react": "npm:react@^19.2.7",
    "react-dom": "npm:react-dom@^19.2.7",
    "tailwind-merge": "npm:tailwind-merge@^3.6.0",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@8.1.3"
  }
}
